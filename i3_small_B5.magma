print "INTEGRAL_POINTS",points;
ts:={};
for P in points do
  xx:=Integers()!P[1];
  if xx gt 0 and xx mod aa eq 0 then
    square,t:=IsSquare(xx div aa);
    if square and t gt 0 then
      yy:=P[2]/(aa*t);
      if Denominator(yy) eq 1 then
        assert yy^2 eq aa*t^4+bb*t^2+cc;
        Include(~ts,t);
      end if;
    end if;
  end if;
end for;
print "POSITIVE_T",ts;
assert not exists{t:t in ts | t eq 2^Valuation(t,2) and 2*Valuation(t,2)+0 ge 49};
end if;
